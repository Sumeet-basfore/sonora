{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "sonora",
  "version": "0.1.0",
  "identifier": "com.sonora.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Sonora",
        "width": 1200,
        "height": 800,
        "minWidth": 800,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "category": "Music",
    "shortDescription": "Local-first desktop music player",
    "longDescription": "Sonora is a local-first desktop music player with a Rust audio engine, synchronized lyrics, FFT visualiser, and a sandboxed plugin system.",
    "linux": {
      "deb": {
        "depends": ["libasound2", "libwebkit2gtk-4.1-0"]
      }
    },
    "windows": {
      "wix": {
        "language": "en-US"
      },
      "nsis": {
        "languages": ["en-US"]
      }
    },
    "macOS": {
      "minimumSystemVersion": "10.15"
    }
  }
}
